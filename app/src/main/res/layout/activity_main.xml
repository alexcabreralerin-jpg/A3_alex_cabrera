<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/textView2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Formulari"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.498"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.042" />

    <EditText
        android:id="@+id/campNom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Escriu el teu nom: "
        android:inputType="textPersonName"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        tools:layout_editor_absoluteY="82dp"
        tools:ignore="MissingConstraints" />

    <EditText
        android:id="@+id/campEmail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Escriu el teu correu: "
        android:inputType="textPersonName"
        app:layout_constraintTop_toBottomOf="@+id/campNom"
        tools:layout_editor_absoluteX="0dp" />

    <EditText
        android:id="@+id/campBio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Escriu la teva biografia"
        android:inputType="textPersonName"
        app:layout_constraintTop_toBottomOf="@+id/campEmail"
        tools:layout_editor_absoluteX="0dp" />

    <EditText
        android:id="@+id/campUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Deixa la URL de la imatge de perfil "
        android:inputType="textPersonName"
        app:layout_constraintTop_toBottomOf="@+id/campBio"
        tools:layout_editor_absoluteX="0dp" />

    <Button
        android:id="@+id/button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Guardar"
        app:layout_constraintTop_toBottomOf="@+id/campUrl"
        tools:layout_editor_absoluteX="156dp"
        tools:ignore="MissingConstraints" />


</androidx.constraintlayout.widget.ConstraintLayout>